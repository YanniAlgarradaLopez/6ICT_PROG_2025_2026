   "outputs": [],
   "source": [
    "afbeelding = cv2.imread(\"../_afbeeldingen/hondkat.png\") \n",
    "afbeelding = cv2.cvtColor(afbeelding, cv2.COLOR_BGR2RGB)\n",
    "plt_imshow(\"Hondkat\", afbeelding)"
